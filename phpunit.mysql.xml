<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.0/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
  <testsuites>
    <testsuite name="Concurrency">
      <directory suffix="Test.php">./tests/Feature/Coupon</directory>
      <directory suffix="Test.php">./tests/Concurrency</directory>
    </testsuite>
  </testsuites>
  <coverage>
    <include>
      <directory suffix=".php">./app</directory>
    </include>
  </coverage>
  <php>
    <server name="APP_ENV" value="testing"/>
    <server name="BCRYPT_ROUNDS" value="4"/>
    <server name="BROADCAST_DRIVER" value="log"/>
    <server name="CACHE_DRIVER" value="array"/>
    <!-- Use MySQL for concurrency tests (NOT SQLite) -->
    <server name="DB_CONNECTION" value="mysql"/>
    <server name="DB_DATABASE" value="meem"/>
    <server name="MAIL_MAILER" value="array"/>
    <server name="QUEUE_CONNECTION" value="sync"/>
    <server name="SESSION_DRIVER" value="array"/>
  </php>
</phpunit>
