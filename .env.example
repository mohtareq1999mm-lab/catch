APP_NAME=ChawkBazar
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_VERSION=6.8.0
APP_SERVICE=marvel.test
DUMMY_DATA_PATH=chawkbazar

# Multilang
# If you want to enable multilang then follow this doc -> https://pickbazar-doc.vercel.app/multilingual
TRANSLATION_ENABLED=false
DEFAULT_LANGUAGE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=catch
DB_USERNAME=root
DB_PASSWORD=

# TiDB only: Pessimistic transaction mode for FOR UPDATE locking.
# Required for coupon claim concurrency safety on TiDB.
# Leave empty/commented on MySQL/MariaDB — TiDB's tidb_txn_mode variable
# does NOT exist on MySQL and will crash every PDO connection with:
#   SQLSTATE[HY000] [1193] Unknown system variable 'tidb_txn_mode'
# For TiDB production, uncomment:
# DB_INIT_COMMAND="SET SESSION tidb_txn_mode = 'pessimistic'"


BROADCAST_DRIVER=pusher
CACHE_DRIVER=redis
QUEUE_CONNECTION=database
# Semantic queue names — physical names are per-project deployment config.
# Override per project: meem → meem-high/meem-medium, catch → catch-high/catch-medium.
QUEUE_HIGH=high
QUEUE_MEDIUM=medium
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# --- Coupon Distribution RabbitMQ event backbone (dedicated; database queue untouched) ---
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=
RABBITMQ_TLS=false
RABBITMQ_EXCHANGE=coupon.events
RABBITMQ_DLX_EXCHANGE=coupon.dlx
RABBITMQ_PREFETCH=10
COUPON_DISTRIBUTION_CHUNK_SIZE=500
COUPON_DISTRIBUTION_AUDIENCE_CAP=10000
# ONE authoritative intentional coupon business delay (minutes). Trigger-run
# fan-out and public-maturity grace derive from it (4 min = 240 s outbox delay).
COUPON_DELAY_MINUTES=4
# Optional explicit overrides (honored when set; otherwise derived from above).
COUPON_DISTRIBUTION_DELAY_SECONDS=240
COUPON_PUBLIC_GRACE_MINUTES=4

MEMCACHED_HOST=memcached

LIGHTHOUSE_CACHE_ENABLE=false

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
CACHE_PREFIX=meem_cache
REDIS_PREFIX=meem_

# Email
# To configure email visit https://chawkbazar-laravel-doc.vercel.app/email-configuration
MAIL_MAILER=mailgun
MAIL_HOST=smtp.mailgun.org
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=
ADMIN_EMAIL=support@example.com

# Rollback to SMTP (uncomment and set MAIL_MAILER=smtp)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.mailgun.org
# MAIL_PORT=587
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_ENCRYPTION=tls

# File system
MEDIA_DISK=public
FILESYSTEM_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=

# Connect With Frontend
SHOP_URL=
DASHBOARD_URL=

# To configure the payment gateway follow this doc -> https://pickbazar-doc.vercel.app/payment
# PAYMENT
# LEGACY (Marvel kernel): still read by packages/marvel/config/shop.php
# (active_payment_gateway, stripe_api_key, paypal sandbox/live blocks). The
# canonical app registry below (config/payment.php) does NOT read these — do
# not remove until the Marvel kernel stops referencing them.
ACTIVE_PAYMENT_GATEWAY=Stripe
# SHARED: read by BOTH config/payment.php (default KWD when unset) and the
# legacy Marvel shop.php (default USD when unset). The sample value below is
# the legacy default; the app treats KWD as canonical unless overridden.
DEFAULT_CURRENCY=USD

# Payment -> Stripe
# LEGACY: STRIPE_API_KEY is read by packages/marvel/config/shop.php only.
# The canonical registry uses STRIPE_SECRET_KEY (see registry section below).
STRIPE_API_KEY=
# LEGACY: STRIPE_WEBHOOK_SECRET_KEY is read by Marvel shop.php only.
# The canonical registry uses STRIPE_WEBHOOK_SECRET (see below).
STRIPE_WEBHOOK_SECRET_KEY=
# Payment -> Paypal

# Add currency like USD
# LEGACY (each): still read by packages/marvel/config/shop.php paypal block.
# The canonical registry uses PAYPAL_MODE/PAYPAL_CLIENT_ID/PAYPAL_CLIENT_SECRET/
# PAYPAL_WEBHOOK_ID/PAYPAL_SUPPORTED_CURRENCIES (see registry section below).
PAYPAL_CURRENCY=
# Change this accordingly for your application.
PAYPAL_NOTIFY_URL=
# force gateway language  i.e. it_IT, es_ES, en_US ... (for express checkout only)
PAYPAL_LOCALE=
# Validate SSL when creating api client.
PAYPAL_VALIDATE_SSL=

# Values: sandbox or live -> sanbox for development and live for production
# SHARED: read by both the canonical registry and legacy Marvel shop.php.
PAYPAL_MODE=

#PayPal Setting & API Credentials - sandbox
# LEGACY: read by packages/marvel/config/shop.php only (canonical registry
# uses a single PAYPAL_CLIENT_ID/ _SECRET pair + PAYPAL_MODE instead).
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=

#PayPal Setting & API Credentials - live
# LEGACY: same as sandbox pair above.
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
# SHARED: PAYPAL_WEBHOOK_ID is read by the canonical registry (webhook
# verification) and the legacy Marvel shop.php block.
PAYPAL_WEBHOOK_ID=
# LEGACY: not read by config/payment.php or shop.php (kept for tooling that
# may reference the historical name).
PAYPAL_REDIRECT_URL=

# Payment -> Mollie
MOLLIE_KEY=
MOLLIE_REDIRECT_URL=
MOLLIE_WEBHOOK_URL=

# Payment -> Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET_KEY=

# Payment -> PayStack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PAYMENT_URL=https://api.paystack.co
MERCHANT_EMAIL=

# Remove sandbox- for production
IYZIPAY_BASE_URL=https://sandbox-api.iyzipay.com
IYZIPAY_API_KEY=YOUR_KEY_HERE
IYZIPAY_SECRET_KEY=YOUR_SECRET_KEY_HERE

# Payment -> bKash
BKASH_SANDBOX=true  #for production use false
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""

# Payment -> Paymongo
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
# This is the secret from the webhook you created.
PAYMONGO_WEBHOOK_SIG=

# Payment -> Flutterwave
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_SECRET_HASH=

# AI --> OpenAi
OPENAI_SECRET_KEY=

# Social Login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1/login/google/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=https://127.0.0.1/login/facebook/callback

# Mailchimp Newslater
NEWSLETTER_API_KEY=
NEWSLETTER_LIST_ID=

# OTP Message System
ACTIVE_OTP_GATEWAY=twilio

TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_VERIFICATION_SID=
TWILIO_FROM_NUMBER=

MESSAGEBIRD_API_KEY=
MESSAGEBIRD_ORIGINATOR=Marvel

# Frontend Cache Webhook
FRONTEND_WEBHOOK_ENABLED=false
FRONTEND_WEBHOOK_URL=
FRONTEND_WEBHOOK_SECRET=
FRONTEND_WEBHOOK_TIMEOUT=10
FRONTEND_WEBHOOK_RETRY_TIMES=3
FRONTEND_WEBHOOK_RETRY_SLEEP=1000
FRONTEND_WEBHOOK_VERSION=1
FRONTEND_WEBHOOK_USER_AGENT=MeemCommerce-Webhook/1.0
# Defaults to ${QUEUE_HIGH} if unset; only override if you need a different webhook queue
FRONTEND_WEBHOOK_QUEUE=${QUEUE_HIGH}

# PUSHER_ENABLED is either true or false
PUSHER_ENABLED=true
PUSHER_APP_ID=7b3b3b3b3b3b3b3b3b3b
PUSHER_APP_KEY=7b3b3b3b3b3b3b3b3b3b
PUSHER_APP_SECRET=7b3b3b3b3b3b3b3b3b3b
PUSHER_APP_CLUSTER=ap2


FIREBASE_CLIENT_A_PROJECT_ID=
FIREBASE_CLIENT_A_CREDENTIALS=client-a-service-account.json
FIREBASE_CLIENT_B_PROJECT_ID=
FIREBASE_CLIENT_B_CREDENTIALS=client-b-service-account.json

# ============================================================
# Digital Products (config/digital.php)
# ============================================================
# Kill-switch for the digital product subsystem (fulfillment + downloads).
DIGITAL_PRODUCTS_ENABLED=true
# ============================================================
# Warehouse Workflow (config/warehouse.php)
# ============================================================
# Master switch for the warehouse workflow. false = Orders-only mode: no new
# fulfillments can be created or released; existing fulfillments continue
# through their original lifecycle. Rebuild the config cache after changing
# this value in production.
WAREHOUSE_WORKFLOW_ENABLED=true
# Global max upload size per digital asset, in KB.
DIGITAL_MAX_UPLOAD_KB=20480
# Default maximum downloads per purchased digital entitlement.
DIGITAL_DOWNLOAD_LIMIT=5
# Signed download URL lifetime in minutes.
DIGITAL_SIGNED_URL_TTL=30
# A1 gate: allow executable/packaged software assets (EXE/MSI/DMG/APK/IPA...).
# Keep false until the hardened software upload pipeline ships.
DIGITAL_ALLOW_SOFTWARE_ASSETS=false

# W5: one-time license key reveal (false = keys re-revealable).
DIGITAL_LICENSE_ONE_TIME_REVEAL=true

# ============================================================
# CORS — X-Currency header (guest currency)
# ============================================================
# Guest currency is now sent via X-Currency header (Frontend-owned, Backend-validated via CurrencyService).
# For localhost dev:
# CORS_ALLOWED_ORIGINS must list the Frontend origin explicitly; wildcard "*" is rejected when credentials needed for auth.
# Guest cookie routes additionally enforce exact-origin CORS: "*" never authorizes them and is never echoed.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS_PATTERNS=
CORS_ALLOWED_HEADERS=Content-Type,Accept,Authorization,lang,x-channel,X-Channel,X-Requested-With,Origin,X-Currency,X-CSRF-Token,Idempotency-Key

# Currency exchange API (Frankfurter — https://frankfurter.dev). When disabled, all external
# rate fetching is blocked; manual rates, stored rates and conversion keep working.
# Keep disabled until the production preflight has verified the fixed mathematical anchor
# and approved the first rates.
CURRENCY_RATE_ANCHOR=USD
CURRENCY_EXCHANGE_API_ENABLED=false
# Legacy alias, used only when CURRENCY_EXCHANGE_API_ENABLED is not set:
# CURRENCY_RATE_SYNC_ENABLED=false
FRANKFURTER_BASE_URL=https://api.frankfurter.dev
CURRENCY_RATE_TIMEOUT=10
CURRENCY_RATE_CONNECT_TIMEOUT=3
CURRENCY_RATE_RETRIES=2
CURRENCY_RATE_RETRY_SLEEP_MS=500
CURRENCY_RATE_LOCK_TTL=3600
CURRENCY_RATE_STALE_AFTER_HOURS=12
CURRENCY_RATE_PROVIDER_MAX_AGE_HOURS=72
CURRENCY_RATE_MAX_CHANGE_PERCENT=30
CURRENCY_RATE_HARD_MAX=1000000
CORS_EXPOSED_HEADERS=
CORS_MAX_AGE=0
CORS_SUPPORTS_CREDENTIALS=true

MIX_PUSHER_APP_KEY=${PUSHER_APP_KEY}
MIX_PUSHER_APP_CLUSTER=${PUSHER_APP_CLUSTER}

# ============================================================
# Payment gateways registry (config/payment.php)
# ============================================================
MYFATOORAH_ENABLED=true
MYFATOORAH_API_KEY=
MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com/v2/
MYFATOORAH_SUPPORTED_CURRENCIES=KWD,SAR,AED,BHD,QAR,OMR,EGP
# Test-gateway bypass (config/payment.php test_gateway_bypass_enabled):
# explicit opt-in for amount/currency mismatch tolerance on the apitest host.
# Requires a local/testing APP_ENV too. Default OFF — never enable in
# production or staging.
PAYMENT_TEST_GATEWAY_BYPASS=false

STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUPPORTED_CURRENCIES=USD,EUR,KWD,SAR,AED

PAYPAL_ENABLED=false
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_SUPPORTED_CURRENCIES=USD,EUR

# ============================================================
# Payment -> Tap (https://developers.tap.company)
# ============================================================
# Tap is disabled by default; enabling it does not affect other gateways.
# TAP_SECRET_KEY: the Secret API Key (sk_test_... / sk_live_...). The mode
#   follows the credential prefix — the same slot serves test and live keys
#   (single-slot convention, same as STRIPE_SECRET_KEY). Never expose it to
#   the frontend; it is also the key used to verify webhook hashstrings.
# TAP_SOURCE_ID: charge source (src_all = hosted payment page with every
#   merchant-enabled method; e.g. src_kw.knet, src_card for a single method).
# TAP_SUPPORTED_CURRENCIES: platform currencies Tap documents (the merchant
#   account may enable a subset). The charge currency is derived from the
#   ORDER (PaymentCurrencyResolver), never hardcoded; unsupported order
#   currencies fail closed with 422.
# Webhook endpoint (public, provider-signed): POST /api/v1/general/checkout/webhooks/tap
#   Set post.url in the charge — the adapter fills it automatically.
TAP_ENABLED=false
TAP_SECRET_KEY=
TAP_BASE_URL=https://api.tap.company/v2
TAP_SOURCE_ID=src_all
TAP_SUPPORTED_CURRENCIES=AED,BHD,EGP,EUR,GBP,JOD,KWD,OMR,QAR,SAR,USD

# ============================================================
# Payment -> Tabby (https://docs.tabby.ai)
# ============================================================
# Tabby is disabled by default; enabling it does not affect other gateways.
# TABBY_SECRET_KEY: the secret API key (sk_test_... for sandbox / sk_... for
#   live). Single-slot convention (same as STRIPE_SECRET_KEY/TAP_SECRET_KEY).
#   Never expose it to the frontend; it authorizes sessions, retrieval,
#   capture, refund and webhook-registration calls.
# TABBY_BASE_URL: regional API base — api.tabby.ai (UAE) or api.tabby.sa
#   (KSA), always /api/v2 (docs.tabby.ai/api-reference/overview).
# TABBY_MERCHANT_CODE: the merchant/branch code Tabby provided (required by
#   the session payload; sent on every session creation).
# TABBY_SUPPORTED_CURRENCIES: Tabby's documented currency enum is AED, SAR
#   only. The payment currency is derived from the ORDER
#   (PaymentCurrencyResolver), never hardcoded; unsupported order currencies
#   fail closed with 422 BEFORE any Tabby call (registry gate + live-adapter
#   double-check + adapter-side guard).
# Lifecycle: server-side verify + capture-first — payments are completed
#   ONLY after Tabby confirms the capture (CLOSED + captures[]); unresolved
#   captures keep the transaction row pending (resumable) and never mark an
#   order paid. TABBY_CAPTURE_ATTEMPTS bounds same-reference_id capture
#   retries (409/5xx/transport); TABBY_CAPTURE_RETRY_DELAY_MS spaces them.
# Webhook endpoint (public, shared-secret header):
#   POST /api/v1/general/checkout/webhooks/tabby
#   Register it once per merchant_code + key (self-service):
#     curl -X POST https://api.tabby.ai/api/v1/webhooks \
#       -H "Authorization: Bearer $TABBY_SECRET_KEY" \
#       -H "X-Merchant-Code: $TABBY_MERCHANT_CODE" \
#       -H "Content-Type: application/json" \
#       -d '{"url": "https://your-host/api/v1/general/checkout/webhooks/tabby",
#            "header": {"title": "x-tabby-signature", "value": "RANDOM_LONG_SECRET"}}'
# TABBY_WEBHOOK_HEADER must equal the registered header TITLE; TABBY_WEBHOOK_SECRET
#   its VALUE (constant-time compared, fail-closed). Both are required before
#   the webhook endpoint accepts any delivery.
TABBY_ENABLED=false
TABBY_SECRET_KEY=
TABBY_BASE_URL=https://api.tabby.ai/api/v2
TABBY_MERCHANT_CODE=
TABBY_WEBHOOK_HEADER=x-tabby-signature
TABBY_WEBHOOK_SECRET=
TABBY_SUPPORTED_CURRENCIES=AED,SAR
TABBY_CAPTURE_ATTEMPTS=2
TABBY_CAPTURE_RETRY_DELAY_MS=2000

# =====================================================================
# TAMARA (MENA BNPL — direct integration, docs.tamara.co). Disabled by
# default. TAMARA_ENVIRONMENT picks the host: sandbox = api-sandbox.tamara.co,
# production = api.tamara.co (TAMARA_API_URL overrides both explicitly).
# TAMARA_API_TOKEN = Bearer credential for ALL API calls; it is a SECRET:
# never set it through admin gateway-settings overrides, never log it.
# TAMARA_NOTIFICATION_TOKEN = the SEPARATE Notification Token from the
#   partner portal that signs webhook tamaraToken JWTs (HS256) — also a
#   secret, same discipline. Register the webhook once in the portal:
#   {APP_URL}/api/checkout/webhooks/tamara
# TAMARA_SUPPORTED_CURRENCIES: Tamara's documented enum is SAR,AED,BHD,KWD,OMR
#   — narrow to the subset your merchant account enables.
# TAMARA_PAYMENT_TYPE / TAMARA_INSTALMENTS: plan knobs (Merchant
#   account decides availability; PAY_BY_INSTALMENTS/3 default).
#   Verify exact enum casing in sandbox before enabling TAMARA_ENABLED=true.
TAMARA_ENABLED=false
TAMARA_ENVIRONMENT=sandbox
TAMARA_API_URL=
TAMARA_API_TOKEN=
TAMARA_NOTIFICATION_TOKEN=
TAMARA_PUBLIC_KEY=
TAMARA_SUPPORTED_CURRENCIES=SAR,AED,BHD,KWD,OMR
TAMARA_ELIGIBILITY_TIMEOUT_MS=200
TAMARA_CAPTURE_ATTEMPTS=2
TAMARA_PAYMENT_TYPE=PAY_BY_INSTALMENTS
TAMARA_INSTALMENTS=3
TAMARA_PLATFORM_LABEL=Meem

# Guest Checkout
# Guest cookie/credential is server-managed; raw tokens are never exposed.
GUEST_CART_TTL_DAYS=7
GUEST_TRACKING_GRACE_DAYS=30
GUEST_CANCEL_TTL_HOURS=72
# Same-site subdomains: leave host-only (empty). Different registrable
# domains require a same-site BFF/proxy; see docs/guest-checkout-frontend-contract.md.
GUEST_COOKIE_DOMAIN=
GUEST_COOKIE_SAMESITE=lax
GUEST_COOKIE_PATH=/api
# Guest order claiming is OTP-gated and DISABLED by default. Enabling this
# flag alone is NOT sufficient: a real GuestPhoneVerificationContract binding
# is also required. See docs/guest-order-claim-activation.md.
GUEST_ORDER_CLAIM_ENABLED=false
GUEST_ORDER_CLAIM_TTL_HOURS=24

# Rate Limiting Global Bypass
DISABLE_RATE_LIMITING=true
